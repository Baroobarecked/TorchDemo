POSTGRES_PASSWORD=CHANGE_ME
APP_DATABASE_URL=postgresql+psycopg://owner:CHANGE_ME@127.0.0.1:5433/rag

# Use ollama (default) or openai for both chat and embeddings.
PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=qwen3-embedding-4b-cpu:latest

# Used only when PROVIDER=openai. Calls may incur charges.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

PREFECT_API_URL=http://lcoalhost:4200/api
RETRIEVAL_MAX_DISTANCE=0.5
